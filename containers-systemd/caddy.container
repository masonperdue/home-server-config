[Unit]
Description=Caddy container
After=caddy-build.service
Wants=caddy-build.service

[Container]
Image=caddy.build
ContainerName=caddy
Secret=cloudflare_api_token,type=env,target=CLOUDFLARE_API_TOKEN
Volume=/home/masonp/.volumes/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/home/masonp/.volumes/caddy/site:/srv
Volume=/home/masonp/.volumes/caddy/data:/data
Volume=/home/masonp/.volumes/caddy/config:/config
Network=host

[Service]
Restart=always
RestartSec=1s

[Install]
WantedBy=default.target

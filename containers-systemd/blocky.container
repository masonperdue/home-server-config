[Unit]
Description=Blocky container

[Container]
Image=ghcr.io/0xerr0r/blocky:latest
ContainerName=blocky
Environment=TZ=America/Los_Angeles
Volume=%h/home-server-config/blocky/config.yml:/app/config.yml:ro
Volume=%h/home-server-config/blocky/allowlist.txt:/app/allowlists/allowlist.txt:ro
Volume=%h/home-server-config/blocky/blocklist.txt:/app/denylists/blocklist.txt:ro
Volume=%h/blocky-cache:/app/cache
AutoUpdate=registry
Network=host

[Service]
Restart=always
RestartSec=1s

[Install]
WantedBy=default.target
